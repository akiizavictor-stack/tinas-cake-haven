{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "magenta", "color": "#C2185B", "name": "Magenta pink" },
				{ "slug": "magenta-dark", "color": "#8E0F43", "name": "Deep magenta" },
				{ "slug": "blush", "color": "#FDE4EE", "name": "Blush pink" },
				{ "slug": "cream", "color": "#FFF8EE", "name": "Cream" },
				{ "slug": "cream-dark", "color": "#F7E9D7", "name": "Butter cream" },
				{ "slug": "chocolate", "color": "#4A2C21", "name": "Chocolate brown" },
				{ "slug": "cocoa", "color": "#7B5544", "name": "Cocoa" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" }
			],
			"gradients": [
				{ "slug": "strawberry-cream", "gradient": "linear-gradient(135deg,#FDE4EE 0%,#FFF8EE 100%)", "name": "Strawberry cream" },
				{ "slug": "magenta-glow", "gradient": "linear-gradient(135deg,#C2185B 0%,#8E0F43 100%)", "name": "Magenta glow" }
			]
		},
		"layout": { "contentSize": "760px", "wideSize": "1200px" },
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Nunito",
					"slug": "body",
					"fontFamily": "Nunito, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
					"fontFace": [
						{ "fontFamily": "Nunito", "fontStyle": "normal", "fontWeight": "200 1000", "fontDisplay": "swap", "src": [ "file:./assets/fonts/nunito-variable.woff2" ] }
					]
				},
				{
					"name": "Playfair Display",
					"slug": "heading",
					"fontFamily": "'Playfair Display', Georgia, 'Times New Roman', serif",
					"fontFace": [
						{ "fontFamily": "Playfair Display", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/playfair-display-700.woff2" ] },
						{ "fontFamily": "Playfair Display", "fontStyle": "italic", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/playfair-display-700-italic.woff2" ] }
					]
				},
				{
					"name": "Dancing Script",
					"slug": "script",
					"fontFamily": "'Dancing Script', cursive",
					"fontFace": [
						{ "fontFamily": "Dancing Script", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dancing-script-variable.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9rem", "name": "Small" },
				{ "slug": "medium", "size": "1.05rem", "name": "Medium" },
				{ "slug": "large", "size": "1.35rem", "fluid": { "min": "1.2rem", "max": "1.35rem" }, "name": "Large" },
				{ "slug": "x-large", "size": "2rem", "fluid": { "min": "1.6rem", "max": "2rem" }, "name": "Extra large" },
				{ "slug": "xx-large", "size": "3rem", "fluid": { "min": "2.2rem", "max": "3rem" }, "name": "Huge" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--cream)", "text": "var(--wp--preset--color--chocolate)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.65", "fontWeight": "400" },
		"spacing": { "blockGap": "1.2rem" },
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--magenta-dark)" },
				":hover": { "color": { "text": "var(--wp--preset--color--magenta)" } }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.01em" },
				"color": { "text": "var(--wp--preset--color--chocolate)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--magenta)", "text": "var(--wp--preset--color--white)" },
				"border": { "radius": "999px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontWeight": "800", "fontSize": "1rem" },
				"spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.6rem", "right": "1.6rem" } },
				":hover": { "color": { "background": "var(--wp--preset--color--magenta-dark)", "text": "var(--wp--preset--color--white)" } },
				":focus": { "color": { "background": "var(--wp--preset--color--magenta-dark)", "text": "var(--wp--preset--color--white)" } }
			},
			"caption": { "typography": { "fontSize": "0.8rem" }, "color": { "text": "var(--wp--preset--color--cocoa)" } }
		},
		"blocks": {
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontSize": "1.4rem", "fontWeight": "700" }, "color": { "text": "var(--wp--preset--color--magenta-dark)" } },
			"core/navigation": { "typography": { "fontSize": "0.98rem", "fontWeight": "700" } },
			"core/post-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)" } },
			"core/quote": { "border": { "left": { "color": "var(--wp--preset--color--magenta)", "width": "4px" } } },
			"core/separator": { "color": { "text": "var(--wp--preset--color--blush)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Wide page (no title banner)", "postTypes": [ "page" ] }
	]
}
